# DiStream Studio Environment Configuration Template
# Copy this file to .env and fill in your credentials (never commit .env)

PORT=21213
DISTREAM_SECRET=replace_with_webhook_hmac_secret
DISTREAM_LICENSE_SECRET=replace_with_license_signing_secret

# Pakasir Payment Gateway (QRIS Automatic Settlement)
PAKASIR_PROJECT=your_pakasir_project_slug
PAKASIR_API_KEY=your_pakasir_api_key
PAKASIR_SANDBOX=true

# Resend Transactional Email Receipt & Activation Key Delivery
RESEND_EMAIL_API_KEY=re_your_api_key
DISTREAM_FROM_EMAIL=onboarding@resend.dev

# Optional Media & Push Integrations
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
ONESIGNAL_XYCLOUDSTORE_APP_ID=your_onesignal_app_id
